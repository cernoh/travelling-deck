{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  // noEmit lives on the CLI (`npm run check` = tsc --noEmit) so the shared
  // config stays compatible with @rollup/plugin-typescript, which forces emit.
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
